# dependencies / build output
node_modules
dist
dist-web
src-tauri/target
server/target

# ...but the vendored Glacier packages ARE the dependency, not build output of
# ours. @glacier/react ships only a dist/ (no src/), so the bare `dist` rule
# above swallowed its entire body and left just the package.json pointing at
# files that were never committed — CI then failed every build with "Cannot
# find module '@glacier/react'" while local installs worked fine.
!vendor/**/dist/
!vendor/**/dist/**

# secrets — never commit
.env
.env.*
!.env.example
*.p12
*.pem
# tauri updater private key (kept in ~/.tauri, but guard against strays)
*updater*.key

# runtime data (SQLite with real accounts/decks)
server/data

# desktop build artifacts
*.dmg
*.msi
*.exe
*.deb
*.rpm
*.AppImage
*.sig

# OS / editor
.DS_Store
.vscode
.idea
*.log
playtest/logs/
