# dependencies / build output
node_modules
dist
dist-web
src-tauri/target
server/target

# ...but the vendored Glacier packages ARE the dependency, not build output of
# ours. @glacier/react ships only a dist/ (no src/), so the bare `dist` rule
# above swallowed its entire body and left just the package.json pointing at
# files that were never committed — CI then failed every build with "Cannot
# find module '@glacier/react'" while local installs worked fine.
!vendor/**/dist/
!vendor/**/dist/**

# secrets — never commit
.env
.env.*
!.env.example
*.p12
*.pem
# tauri updater private key (kept in ~/.tauri, but guard against strays)
*updater*.key

# runtime data (SQLite with real accounts/decks)
server/data

# desktop build artifacts
*.dmg
*.msi
*.exe
*.deb
*.rpm
*.AppImage
*.sig

# OS / editor
.DS_Store
.vscode
.idea
*.log
playtest/logs/

# Throwaway debug/probe pages. vite copies public/ verbatim into dist/ and
# redeploy rsyncs dist/ to the web root, so anything left here ships publicly.
public/__*.html

# Tauri mobile scaffolding. `tauri ios init` regenerates the Xcode project from
# project.yml, and the build drops DerivedData-style artefacts in here; the two
# files worth versioning are checked in explicitly below.
src-tauri/gen/apple/*
!src-tauri/gen/apple/project.yml
# The iOS app icons are hand-composited from the brand mark (opaque, full-bleed
# - see the commit that added them), NOT regenerable by `tauri icon`, so they
# are versioned rather than treated as build output.
!src-tauri/gen/apple/Assets.xcassets/**
!src-tauri/gen/apple/ExportOptions.plist
